		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@deno/kv": "^0.14.0",
		"@react2svelte/swipeable": "^0.1.4",
